# Thesis results are small and needed to regenerate the tables/figures; keep them, except caches.
# (Full RAGAS run files in eval/results/*.json stay ignored: ~5-14 MB each.)
!eval/results/
eval/results/*
!eval/results/thesis/
# LLM-output caches (small, make reruns free and identical) are kept; embeddings and ColBERT are rebuilt.
eval/results/thesis/cache/embeddings.jsonl

# Office lock files
~$*
eval/results/thesis/models/
eval/results/thesis/cache/colbert/


# demo app full-page screenshots (scripts/thesis/demo_screenshots.py); the cropped figures are tracked
eval/results/thesis/figures/demo/raw/
