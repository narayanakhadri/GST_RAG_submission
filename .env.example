# Copy to .env and fill in the keys. Every setting and its default is in app/config.py.

# --- LLM used for generation, CRAG grading, HyDE, Self-RAG (openai | groq | gemini) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=            # one or more comma-separated keys; rotated on 429/5xx
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=              # needed by scripts/gst_pipeline/enrich.py
GROQ_MODEL_ANSWER=llama-3.1-8b-instant
OPENAI_API_KEY=            # always needed: embeddings use OpenAI regardless of LLM_PROVIDER
LLM_MODEL_ANSWER=gpt-4o
LLM_MODEL_GRADER=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DISK_CACHE=eval/results/thesis/cache/embeddings.jsonl

# --- RAGAS judge (every reported number used this judge, via OpenRouter) ---
RAGAS_JUDGE_BASE_URL=https://openrouter.ai/api/v1
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_MODEL=qwen/qwen3-30b-a3b-instruct-2507
RAGAS_JUDGE_EXTRA_BODY={"provider": {"order": ["siliconflow"], "allow_fallbacks": false}}
RAGAS_METRICS=faithfulness,answer_relevancy

# --- Infrastructure (docker compose up -d) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gst_provisions_enriched_v3
GST_QDRANT_COLLECTION=gst_provisions_enriched_v3
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adv_rag

# --- Optional ---
JWT_SECRET=                # required by the API (any long random string)
TAVILY_API_KEY=            # CRAG web fallback; errors are caught if unset
UPSTASH_REDIS_URL=         # empty = in-memory cache
UPSTASH_REDIS_TOKEN=
VOYAGE_API_KEY=            # only for RERANKER_BACKEND=voyage
RERANKER_BACKEND=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CRAG_ENABLED_BY_DEFAULT=true
RAG_ANSWER_CACHE_ENABLED=false
